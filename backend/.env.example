# Local Supabase defaults only. Never commit production credentials.
SUPABASE_DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres?sslmode=disable
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=postgres
SUPABASE_API_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
PORT=8080
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=3000
# Exact local and production frontend origins. Do not include paths or trailing slashes.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://unibus-sch.vercel.app,https://unibus-sch-two.vercel.app
# Keep preview wildcards scoped to the known Vercel project/account hostnames.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://unibus-sch-git-*-ddingddong9s-projects.vercel.app,https://unibus-sch-*-ddingddong9s-projects.vercel.app,https://unibus-*-ddingddong9s-projects.vercel.app
# Read-only startup check. Keep enabled outside focused tests.
APP_SCHEMA_VALIDATION_ENABLED=true
NAVER_CLIENT_ID=
NAVER_SECRET_KEY=
KAKAO_USER_INFO_URL=https://kapi.kakao.com/v2/user/me
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sch.ac.kr
PUSH_ALLOWED_HOSTS=
