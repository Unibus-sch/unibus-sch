# Copy to .env.staging only on the staging host. Replace every placeholder there.
# Never commit the populated file or paste its contents into logs/issues.

UNIBUS_BACKEND_IMAGE=REGISTRY_HOST/ORGANIZATION/unibus-backend@sha256:IMAGE_DIGEST
UNIBUS_STAGING_BIND_ADDRESS=127.0.0.1
UNIBUS_STAGING_PORT=18080

SUPABASE_DB_URL=jdbc:postgresql://STAGING_DB_HOST:5432/DATABASE_NAME?sslmode=require
SUPABASE_DB_USERNAME=STAGING_DB_USERNAME
SUPABASE_DB_PASSWORD=SECRET_MANAGER_SUPABASE_DB_PASSWORD
SUPABASE_API_URL=https://STAGING_SUPABASE_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SECRET_MANAGER_SUPABASE_SERVICE_ROLE_KEY

APP_CORS_ALLOWED_ORIGINS=https://STAGING_FRONTEND_HOST
APP_CORS_ALLOWED_ORIGIN_PATTERNS=

NAVER_CLIENT_ID=STAGING_NAVER_CLIENT_ID
NAVER_SECRET_KEY=SECRET_MANAGER_NAVER_SECRET_KEY
KAKAO_USER_INFO_URL=https://kapi.kakao.com/v2/user/me

VAPID_PUBLIC_KEY=STAGING_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=SECRET_MANAGER_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:STAGING_OPERATOR_EMAIL
PUSH_ALLOWED_HOSTS=STAGING_WEB_PUSH_PROVIDER_HOSTS

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=3000

UNIBUS_LOG_FORMAT=logstash
UNIBUS_LOG_LEVEL_ROOT=INFO
UNIBUS_LOG_LEVEL_APP=INFO
UNIBUS_DOCKER_LOG_MAX_SIZE=10m
UNIBUS_DOCKER_LOG_MAX_FILE=5

UNIBUS_STAGING_CPU_LIMIT=1.0
UNIBUS_STAGING_MEMORY_LIMIT=768M
