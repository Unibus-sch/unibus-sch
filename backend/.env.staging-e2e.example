# Git에서 제외되는 backend/.env.staging-e2e.local로 복사하고 chmod 600으로 권한을 제한하세요.
# 비밀번호 관리 도구로 만든 새 스테이징 접속정보만 입력하세요. 실제 값은 커밋하지 마세요.
UNIBUS_TARGET_ENV=staging
STAGING_PROJECT_REF=srxzkpdtxmqrtcxgpeyl
SUPABASE_API_URL=https://srxzkpdtxmqrtcxgpeyl.supabase.co
SUPABASE_DB_URL='jdbc:postgresql://db.srxzkpdtxmqrtcxgpeyl.supabase.co:5432/postgres?sslmode=verify-full'
SUPABASE_DB_USERNAME=STAGING_DB_USERNAME
SUPABASE_DB_PASSWORD=STAGING_DB_PASSWORD
STAGING_ADMIN_EMAIL=unibus-staging-admin@example.invalid
STAGING_DRIVER_EMAIL=unibus-staging-driver@example.invalid
STAGING_ADMIN_PASSWORD=NEW_UNIQUE_STAGING_ADMIN_PASSWORD
STAGING_DRIVER_PASSWORD=NEW_UNIQUE_STAGING_DRIVER_PASSWORD
STAGING_FIXTURE_MODE=prepare
STAGING_API_URL=https://api-staging.unibus-sch.com
