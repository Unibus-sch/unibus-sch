{
  "name": "unibus-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-env.mjs && vite build",
    "build:single": "node scripts/validate-env.mjs && cross-env SINGLE_FILE=true vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:env": "node --test scripts/validate-env.test.mjs",
    "test:staging-smoke": "node --test scripts/staging-smoke.test.mjs",
    "verify:env": "node scripts/validate-env.mjs",
    "verify:parity": "node scripts/verify-edge-spring-parity.mjs",
    "verify:staging": "node scripts/verify-staging-smoke.mjs",
    "verify:integrations": "node scripts/verify-supabase-integrations.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.0",
    "@tailwindcss/vite": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.18.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.80.0",
    "react-resizable-panels": "^3.0.3",
    "react-router": "^6.26.2",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.1.2",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
